# Copy to server/.env and never commit the real values.
MONGO_URI=mongodb://localhost:27017/musistats
ACCESS_TOKEN_SECRET=change-me-long-random-string
REFRESH_TOKEN_SECRET=change-me-different-long-random-string
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/auth/spotify/callback
# Generate with: openssl rand -hex 32
SPOTIFY_TOKEN_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
NODE_ENV=development
